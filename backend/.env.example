# FinTax Server Configuration
PORT=5000
CLIENT_URL=http://localhost:5173

# AI Processing Switch (Set false on server to completely disable Ollama/AI and run 100% silent & lightweight)
ENABLE_AI=true

# Local AI (Ollama on NVIDIA RTX A2000 GPU)
AI_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=moondream

# Cloud Gemini Fallback (Optional)
GEMINI_API_KEY=your_gemini_api_key_here

# Storage Paths
STORAGE_VAULT=../storage/vault
STORAGE_EXPORTS=../storage/exports
STORAGE_TEMP=../storage/temp
GOOGLE_DRIVE_PATH=../storage/google_drive

# Database Connection
DATABASE_URL="postgresql://postgres:password@localhost:5432/fintax_db?schema=public"
